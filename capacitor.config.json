{
  "appId": "com.vigor.app.boost",
  "appName": "Vital",
  "webDir": "www",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 0,
      "launchAutoHide": true,
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": true
    }
  }
}
